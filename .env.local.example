# Local values come from `npx supabase status` after `npm run db:start`:
# API_URL, PUBLISHABLE_KEY and SECRET_KEY. Production uses the project's publishable
# (sb_publishable_…) and secret (sb_secret_…) keys, never the legacy JWT keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional locally: push notifications. Without both, sending is a no-op and Settings says
# notifications aren't available. Generate a pair with `npx web-push generate-vapid-keys`.
# Production boots without them too, but logs "Push notifications are off" and sends nothing.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: off when unset. A Sentry DSN (errors only) and the healthchecks.io ping URL the daily
# cron calls; see docs/ARCHITECTURE.md, Observability. Production only; leave blank locally.
NEXT_PUBLIC_SENTRY_DSN=
HEALTHCHECKS_KEEP_ALIVE_URL=
HEALTHCHECKS_CLOSING_ALERTS_URL=

# Optional: Google's own sign-in button, so Google's account chooser names this site rather than the
# Supabase project. Public (it's in the page). Without it, sign-in uses Supabase's Google redirect.
# Read at build time. Locally it only works if the Google client lists http://localhost:3000 as a
# JavaScript origin and http://localhost:3000/auth/google as a redirect URI (docs/OPERATIONS.md).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
